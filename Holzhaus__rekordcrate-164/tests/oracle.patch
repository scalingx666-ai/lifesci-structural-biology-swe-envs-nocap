+
+    impl<T: BinRead + BinWrite> std::ops::Deref for SingleTarget<T> {
+        type Target = T;
+        fn deref(&self) -> &Self::Target {
+            &(self.0)
+        }
+    }
+
+    #[test]
+    fn empty() {
+        let empty_offset_tail_u8 = OffsetArrayContainer {
+            offsets: OffsetArray::U8([]),
+            inner: IgnoreArgs(()),
+        };
+        test_roundtrip_with_args(
