+            empty_offset_tail_u8,
+            (0, OffsetSize::U8, ()),
+            (0, OffsetSize::U8, ()),
+        );
+        let empty_offset_tail_u16 = OffsetArrayContainer {
+            offsets: OffsetArray::U16([]),
+            inner: IgnoreArgs(vec![(); 0]),
+        };
+        test_roundtrip_with_args(
+            &[],
+            empty_offset_tail_u16,
+            (
+                0,
+                OffsetSize::U16,
+                VecArgs {
+                    count: 0,
+                    inner: (),
+                },
