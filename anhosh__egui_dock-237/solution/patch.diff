+            Self::draw_arrow(collapsed, ui, color, arrow_rect);
+        }
+
+        // Draw button right border.
+        ui.painter().vline(
+            rect.right(),
+            rect.y_range(),
+            Stroke::new(
+                ui.ctx().pixels_per_point().recip(),
+                style.buttons.collapse_tabs_border_color,
