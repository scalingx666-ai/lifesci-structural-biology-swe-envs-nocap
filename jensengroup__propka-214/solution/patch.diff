+def _normalize_element(element: str) -> str:
+    # Normalize element symbols such as c -> C, cl -> Cl, and ZN -> Zn.
+    element = element.strip()
+    if not element:
+        return ''
+    return '{0:1s}{1:s}'.format(element[0].upper(), element[1:].lower())
