+
+def _get_mmcif_value(columns, row: int, names, default: str = '') -> str:
+    for name in names:
+        column = columns.get(name)
+        if column is None:
+            continue
+        value = column[row]
+        if not gemmi.cif.is_null(value):
+            return gemmi.cif.as_string(value)
+    return default
