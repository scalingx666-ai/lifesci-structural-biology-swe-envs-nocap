+        raise ValueError(
+            'Missing required mmCIF atom_site value at row {0:d}: {1:s}'.format(
+                row + 1, fields))
+    return value
+
+
+def _get_required_mmcif_int(columns, row: int, names) -> int:
+    value = _get_required_mmcif_value(columns, row, names)
