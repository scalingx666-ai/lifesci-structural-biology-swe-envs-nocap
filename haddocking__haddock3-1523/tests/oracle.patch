@@ -0,0 +1,29 @@
+# ====================================================================
+# Protein-ligand docking example
+
+# directory in which the scoring will be done
+run_dir = "run1-refine-ligand-autotoppar-test"
+
+# execution mode
+mode = "local"
+ncores = 50
+debug = true
+clean = false
+
+# molecules to be docked
+molecules =  [
+    "data/oseltamivir_zwitterion.pdb"
+    ]
+
+# ====================================================================
+# Parameters for each stage are defined below
+# ====================================================================
+[topoaa]
+autohis = true
+delenph = false
+hydrogen_build = "unknown"
+autotoppar = true
+
+[emref]
+
+# ====================================================================
