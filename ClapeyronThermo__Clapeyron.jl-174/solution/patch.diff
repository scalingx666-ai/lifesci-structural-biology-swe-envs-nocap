+    if haskey(kwargs,:equilibrium) || haskey(kwargs,:K0) || haskey(kwargs,:y0) || haskey(kwargs,:x0)
+        return MichelsenTPFlash(;kwargs...)
+    elseif haskey(kwargs,:numphases)
+        return DETPFlash(;kwargs...)
+    else
+        return DETPFlash(;kwargs...)
+    end
+end
