+struct Complex {
+    int complexId;
+    unsigned int nChain;
+    unsigned int complexLength;
+    std::string complexName;
+    std::vector<unsigned int> chainLengths;
+    std::vector<unsigned int> chainKeys;
+
+    // Coordinate16 Coords;
+
+    Complex() : complexId(0), nChain(0), complexLength(0), complexName("") {}
+    ~Complex() {
+        chainKeys.clear();
+    }
