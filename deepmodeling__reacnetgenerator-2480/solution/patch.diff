+            lambda *args: calls.append("reference") or reference,
+        )
+
+        assert detect_instance._getbondfromcrd(atoms, np.eye(3) * 10) == accelerated
+        assert calls == ["fast"]
+
+        calls.clear()
+        monkeypatch.setattr(
