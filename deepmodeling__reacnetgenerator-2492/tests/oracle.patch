+    if mode != "legacy":
+        options = {"max_inflight": 2, "chunksize": 1, "disk_ordered": mode == "ordered"}
+    results = list(
+        utils.run_mp(
+            1,
+            func=_read_initialized_value,
+            l=[3, 4],
+            initializer=_initialize_value,
+            initargs=("attached",),
+            unordered=mode != "ordered",
+            total=2,
+            bar=False,
+            **options,
+        )
+    )
+    assert results == [("attached", 1, 3), ("attached", 1, 4)]
