+              "    var delta = [DRAG_START[0] - DRAG_CURRENT[0],\n",
+              "                 -DRAG_START[1] + DRAG_CURRENT[1]];\n",
+              "    delta = [delta[0] / canvas.width * 2, delta[1] / canvas.height * 2];\n",
+              "    if (DIMENSION == 2) {\n",
+              "      delta = [delta[0] * CAMERA_SIZE[0],\n",
+              "               delta[1] * CAMERA_SIZE[1]];\n",
