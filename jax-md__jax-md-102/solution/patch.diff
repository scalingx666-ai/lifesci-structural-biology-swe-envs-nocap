+              "\n",
+              "  function make_disk(gl, shader, segments, radius) {\n",
+              "    var position = new Float32Array(segments * DIMENSION * 3);\n",
+              "    for (var s = 0 ; s < segments ; s++) {\n",
+              "        const th = 2 * s / segments * Math.PI;\n",
