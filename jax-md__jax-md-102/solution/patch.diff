+              "        position.set([radius * Math.cos(th_p), radius * Math.sin(th_p)], \n",
+              "                     s * 3 * DIMENSION + 2 * DIMENSION);\n",
+              "    }\n",
+              "\n",
+              "    var buffer = gl.createBuffer();\n",
