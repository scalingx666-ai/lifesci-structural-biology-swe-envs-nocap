+
+        out = torch.empty_like(src)
+        for ax in range(0, para_dim, chunk_size):
+            x = self.norm(src[:, ax:ax + chunk_size, :, :])
+            x = self.linear2(F.relu(self.linear1(x)))
+            out[:, ax:ax + chunk_size, :, :] = x
+        out.add_(src)
+        return out
