diff --git a/conf/test_full_alphafold3.config b/conf/test_full_alphafold3.config
new file mode 100644
index 000000000..58d8f6f25
--- /dev/null
+++ b/conf/test_full_alphafold3.config
@@ -0,0 +1,22 @@
+/*
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+    Nextflow config file for running full-size tests
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+    Defines input files and everything required to run a full size pipeline test.
+
+    Use as follows:
+        nextflow run nf-core/proteinfold -profile test_full_alphafold3,<docker/singularity> --outdir <OUTDIR>
+
+----------------------------------------------------------------------------------------
+*/
+
+params {
+    config_profile_name        = 'Full test profile for alphafold3'
+    config_profile_description = 'Full test dataset to check pipeline function'
+
+    // Input data for full test of alphafold3
+    mode          = 'alphafold3'
+    use_gpu       = true
+    input         = params.pipelines_testdata_base_path + 'proteinfold/testdata/samplesheet/v2.0/samplesheet.csv'
+    alphafold3_db = 's3://proteinfold-dataset/test-data/mini_dbs'
+}
