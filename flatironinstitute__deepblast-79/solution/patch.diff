+def score_global_alignment(df, col, k, n_cores=4):
+    import dask.dataframe as dd
+    df2 = dd.from_pandas(df, npartitions=n_cores)
+    func = lambda x: alignment_score_kernel(x['manual'], x[col], k)
+    res = df2.apply(func, axis=1)
+    resdf = res.compute(scheduler='processes')
+    return pd.DataFrame(list(resdf.values), columns=k)
diff --git a/deepblast/tests/test_score.py b/deepblast/tests/test_score.py
new file mode 100644
index 0000000..0bb7275
--- /dev/null
+++ b/deepblast/tests/test_score.py
@@ -0,0 +1,31 @@
+import unittest
+from deepblast.score import alignment_score, alignment_score_kernel
+
+
+class TestScore(unittest.TestCase):
+
+    def setUp(self):
+        pass
+
+    def test_alignment_score(self):
+        s = ":11::21:"
+        p = ":11::12:"
+        alignment_score(s, p)
+
+    def test_alignment_score_no_gaps(self):
+        s = ":11::21:"
+        p = ":11::12:"
+        score = alignment_score(s, p, no_gaps=True)
+        self.assertEqual(score[0], 4)
+        self.assertEqual(score[1], 0)
+        self.assertEqual(score[2], 0)
+
+    def test_alignment_score_kernel(self):
+        s = ":11::21:"
+        p = ":11::12:"
+        k = [1, 2]
+        alignment_score_kernel(s, p, k, no_gaps=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
