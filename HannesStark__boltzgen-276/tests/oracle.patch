+
+            # Ligand atom context
+            Y = torch.cat((R, Y), 2)  # [B, L, atoms, 3]
+            Y_m = torch.cat((R_m, Y_m), 2)  # [B, L, atoms]
+            Y_t = torch.cat((R_t, Y_t), 2)  # [B, L, atoms]
