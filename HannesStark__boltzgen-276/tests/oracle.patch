+
+        offset = R_idx[:, :, None] - R_idx[:, None, :]
+        offset = gather_edges(offset[:, :, :, None], E_idx)[:, :, :, 0]  # [B, L, K]
+
+        d_chains = (
+            (chain_labels[:, :, None] - chain_labels[:, None, :]) == 0
+        ).long()  # find self vs non-self interaction
