diff --git a/.github/release.yml b/.github/release.yml
new file mode 100644
index 00000000..cd6a0f97
--- /dev/null
+++ b/.github/release.yml
@@ -0,0 +1,66 @@
+# GitHub Release Notes Configuration
+# Automatically categorizes pull requests in release notes based on labels
+# See: https://docs.github.com/en/repositories/releasing-projects-on-github/automatically-generated-release-notes
+
+changelog:
+  exclude:
+    labels:
+      - ignore-for-release
+      - duplicate
+      - invalid
+      - wontfix
+      - question
+      - help-wanted
+      - good-first-issue
+    authors:
+      - github-actions
+      - dependabot
+      - dependabot[bot]
+      - renovate
+      - renovate[bot]
+      - pre-commit-ci
+      - pre-commit-ci[bot]
+
+  categories:
+    - title: 💥 Breaking Changes
+      labels:
+        - breaking
+    - title: 🎉 New Features
+      labels:
+        - feature
+    - title: 🛠 Enhancements
+      labels:
+        - enhancement
+    - title: 🐛 Bug Fixes
+      labels:
+        - fix
+    - title: 📖 Documentation
+      labels:
+        - docs
+    - title: 🧹 House-Keeping
+      labels:
+        - maintenance
+    - title: 🚀 Performance
+      labels:
+        - perf
+    - title: 🚧 CI
+      labels:
+        - ci
+    - title: 💡 Refactoring
+      labels:
+        - refactor
+    - title: 🧪 Tests
+      labels:
+        - tests
+    - title: 🏥 Package Health
+      labels:
+        - pkg
+    - title: 📦 Dependencies
+      labels:
+        - deps
+    - title: 🏷️ Type Hints
+      labels:
+        - types
+    - title: 🤷‍♂️ Other Changes
+      labels:
+        - '*'
