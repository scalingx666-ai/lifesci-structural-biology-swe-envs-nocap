+
+    if _VERBOSE_TESTS:
+      print('\nWindow comparison:')
+      print(
+        'window  lambdaQ  lambdaLJ      openmm_kj         jax_kj     gromacs_kj    omm-gmx    jax-gmx    jax-omm'
+      )
+
+    for window, (lambda_q, lambda_lj) in enumerate(
