+              "  function make_sphere(gl, shader, horizontal_segments, vertical_segments, radius) {\n",
+              "    const stride = DIMENSION * 3 * 2;  // 3 vertices per tri, two tris per quad.\n",
+              "    if (DIMENSION != 3) {\n",
