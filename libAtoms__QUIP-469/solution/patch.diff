+# CDEBUG=
+CFLAGS += -Wno-return-type -Wno-implicit-int
+F95FLAGS += -arch arm64
+MATH_LINKOPTS=-L/opt/arm64-builds/lib/ -lopenblas
+EXTRA_LINKOPTS=
+HAVE_CP2K=0
+HAVE_VASP=1
+HAVE_TB=1
+HAVE_PRECON=0
+HAVE_LOTF=0
+HAVE_ONIOM=0
+HAVE_LOCAL_E_MIX=0
+HAVE_QC=0
+HAVE_GAP=1
+HAVE_QR=1
+HAVE_THIRDPARTY=0
+HAVE_FX=0
+HAVE_SCME=0
+HAVE_MTP=0
+HAVE_MBD=0
+HAVE_TTM_NF=0
