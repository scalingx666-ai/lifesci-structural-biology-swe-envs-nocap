+F95=${FC_ARM64}
+CC=gcc
+CPLUSPLUS=g++
+# FPP=gfortran -E -x f95-cpp-input
+LINKER=${FC_ARM64}
+LINKOPTS += ${LDFLAGS}
+# LIBTOOL=
+# OPTIM=
+# COPTIM=
+# DEBUG=-O0 -g -DDUMP_CORE_ON_ABORT -DDEBUG -fbounds-check
