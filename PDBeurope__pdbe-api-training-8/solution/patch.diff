+        "    return ds\n",
+        "    \n",
+        "def pandas_plot(list_of_results, column_to_group_by, graph_type='bar', top10=False):\n",
+        "    ds = pandas_count(list_of_results=list_of_results, column_to_group_by=column_to_group_by)\n",
+        "    if top10 == True:\n",
