+function excess_g_comb(model::NRTLAssocModel,p,T,z)
+    Tz = Base.promote_eltype(T, z)
+    R = R̄
+    x = z ./ sum(z)
+    comps = @comps
+    n = sum(z)
+
+    rI = model.params.rI.values
+
+    ϕ_I = rI ^ (2/3) .* x ./ sum(rI ^ (2/3) .* x)
+    lnγ_comb = one(Tz) - ϕ_I./x - ln(ϕ_I./x)
+
+    return n * R * T * sum(lnγ_comb)
+end
