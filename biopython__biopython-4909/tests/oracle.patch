-def _mle(
-    N,
-    M,
-    training_outputs,
-    training_states,
-    pseudo_initial,
-    pseudo_transition,
-    pseudo_emission,
-):
-    """Implement Maximum likelihood estimation algorithm (PRIVATE)."""
-    # p_initial is the probability that a sequence of states starts
-    # off with a particular one.
-    p_initial = np.zeros(N)
