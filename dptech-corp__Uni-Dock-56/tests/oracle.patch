+    for (int i = 0; i < 3; i++) g_new->orientation[i] = g_old->orientation[i];
+    for (int i = 0; i < MAX_NUM_OF_LIG_TORSION; i++) g_new->lig_torsion[i] = g_old->lig_torsion[i];
