-__device__ __forceinline__ void curl_with_deriv(float* e, float* deriv, float v,
-                                                const float epsilon_fl) {
-    if (*e > 0 && not_max_gpu(v)) {
-        float tmp = (v < epsilon_fl) ? 0 : (v / (v + *e));
-        *e *= tmp;
-        for (int i = 0; i < 3; i++) deriv[i] *= pow(tmp, 2);
-    }
-}
