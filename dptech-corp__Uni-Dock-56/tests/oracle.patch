+__device__ __forceinline__ void normalize_angle(float *x) {
+    while (1) {
+        if (*x >= -(M_PI_F) && *x <= (M_PI_F)) {
+            break;
+        } else if (*x > 3 * (M_PI_F)) {
+            float n = (*x - (M_PI_F)) / (2 * (M_PI_F));
+            *x -= 2 * (M_PI_F)*ceil(n);
+        } else if (*x < 3 * -(M_PI_F)) {
+            float n = (-*x - (M_PI_F)) / (2 * (M_PI_F));
+            *x += 2 * (M_PI_F)*ceil(n);
+        } else if (*x > (M_PI_F)) {
+            *x -= 2 * (M_PI_F);
+        } else if (*x < -(M_PI_F)) {
+            *x += 2 * (M_PI_F);
+        } else {
+            break;
+        }
+    }
+}
