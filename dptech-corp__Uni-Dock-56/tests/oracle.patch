+__device__ __forceinline__ float vec_distance_sqr(float *a, float *b) {
+    return (a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1])
+           + (a[2] - b[2]) * (a[2] - b[2]);
+}
