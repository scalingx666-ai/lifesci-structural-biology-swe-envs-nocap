+    N = Val(length(Xsol))
+    f(X_::XX_,tups_::Tuple{KK_,Val{N_}}) where {V1_,V2_,N_,XX_<:AbstractVector{V1_},KK_<:AbstractMatrix{V2_}} = begin 
+        TT = promote_type(V1_,V2_)
