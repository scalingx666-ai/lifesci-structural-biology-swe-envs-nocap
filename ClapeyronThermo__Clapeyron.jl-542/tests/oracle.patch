+        #tmp = SVector{N_,TT}(itt)
+        tmp = K_ * X_ # K * X, allocates initial Vector{TT} buffer=#
+        tmp .*= X_ # (K * X) .* X
+        tmp .+= X_ # (K * X) .* X .+ X
+        tmp .-= _1 # (K * X) .* X .+ X .- 1
+        tmp
+    end# (1 + ∑_{jb} K⁽ⁱᵃʲᵇ⁾X⁽ⁱᵃʲᵇ⁾ )⁻¹ = Xⁱᵃ for all iₐ, but rearranged. 
