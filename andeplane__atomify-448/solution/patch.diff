diff --git a/src/utils/leftDragPan.test.ts b/src/utils/leftDragPan.test.ts
new file mode 100644
index 00000000..2d8cfc2a
--- /dev/null
+++ b/src/utils/leftDragPan.test.ts
@@ -0,0 +1,84 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { remapLeftDragToPan } from "./leftDragPan";
+
+describe("remapLeftDragToPan", () => {
+  let container: HTMLDivElement;
+  let canvas: HTMLCanvasElement;
+  let overlay: HTMLDivElement;
+  let received: MouseEvent[];
+
+  beforeEach(() => {
+    container = document.createElement("div");
+    canvas = document.createElement("canvas");
+    overlay = document.createElement("div");
+    container.append(canvas, overlay);
+    document.body.append(container);
+    received = [];
+    // Stands in for omovi's ComboControls and picking handler
+    canvas.addEventListener("mousedown", (ev) => received.push(ev));
+  });
+
+  afterEach(() => {
+    container.remove();
+  });
+
+  it("re-dispatches left-button mousedowns on the canvas as right-button", () => {
+    // Arrange
+    remapLeftDragToPan(container, canvas);
+    const bubbled = vi.fn();
+    window.addEventListener("mousedown", bubbled);
+
+    // Act
+    canvas.dispatchEvent(
+      new MouseEvent("mousedown", {
+        bubbles: true,
+        button: 0,
+        buttons: 1,
+        clientX: 12,
+        clientY: 34,
+        shiftKey: true,
+      }),
+    );
+    window.removeEventListener("mousedown", bubbled);
+
+    // Assert
+    expect(received).toHaveLength(1);
+    expect(received[0]).toMatchObject({
+      button: 2,
+      buttons: 2,
+      clientX: 12,
+      clientY: 34,
+      shiftKey: true,
+    });
+    expect(bubbled).toHaveBeenCalledTimes(1);
+  });
+
+  it("leaves right-button mousedowns and other targets untouched", () => {
+    remapLeftDragToPan(container, canvas);
+    const right = new MouseEvent("mousedown", { bubbles: true, button: 2 });
+    canvas.dispatchEvent(right);
+    const overlayDown = vi.fn();
+    overlay.addEventListener("mousedown", overlayDown);
+    overlay.dispatchEvent(
+      new MouseEvent("mousedown", { bubbles: true, button: 0 }),
+    );
+
+    expect(received).toEqual([right]);
+    expect(overlayDown).toHaveBeenCalledTimes(1);
+  });
+
+  it("shows a move cursor and restores rotate behaviour on cleanup", () => {
+    canvas.style.cursor = "crosshair";
+    const cleanup = remapLeftDragToPan(container, canvas);
+    expect(canvas.style.cursor).toBe("move");
+
+    cleanup();
+    canvas.dispatchEvent(
+      new MouseEvent("mousedown", { bubbles: true, button: 0 }),
+    );
+
+    expect(canvas.style.cursor).toBe("crosshair");
+    expect(received).toHaveLength(1);
+    expect(received[0].button).toBe(0);
+  });
+});
diff --git a/src/utils/leftDragPan.ts b/src/utils/leftDragPan.ts
new file mode 100644
index 00000000..ef7264eb
--- /dev/null
+++ b/src/utils/leftDragPan.ts
@@ -0,0 +1,49 @@
+/**
+ * Make left-drag pan the omovi camera instead of rotating it.
+ *
+ * omovi's ComboControls hardcode the left button to rotate and the right
+ * button to pan, and expose no way to remap them. While installed, a
+ * left-button mousedown on the canvas is stopped in the capture phase on its
+ * container (so neither the controls nor anything else sees it) and
+ * re-dispatched on the canvas as a right-button mousedown. The controls track
+ * the drag from window mousemove/mouseup and only read coordinates, and the
+ * particle picker records the same position and Shift state, so clicks and
+ * Shift+click selection keep working.
+ *
+ * Returns a cleanup function that removes the remapping.
+ */
+export function remapLeftDragToPan(
+  container: HTMLElement,
+  canvas: HTMLElement,
+): () => void {
+  const onMouseDown = (ev: MouseEvent) => {
+    if (ev.target !== canvas || ev.button !== 0) return;
+    ev.stopPropagation();
+    canvas.dispatchEvent(
+      new MouseEvent("mousedown", {
+        bubbles: true,
+        cancelable: true,
+        composed: true,
+        view: ev.view,
+        detail: ev.detail,
+        screenX: ev.screenX,
+        screenY: ev.screenY,
+        clientX: ev.clientX,
+        clientY: ev.clientY,
+        ctrlKey: ev.ctrlKey,
+        shiftKey: ev.shiftKey,
+        altKey: ev.altKey,
+        metaKey: ev.metaKey,
+        button: 2,
+        buttons: 2,
+      }),
+    );
+  };
+  const previousCursor = canvas.style.cursor;
+  canvas.style.cursor = "move";
+  container.addEventListener("mousedown", onMouseDown, true);
+  return () => {
+    container.removeEventListener("mousedown", onMouseDown, true);
+    canvas.style.cursor = previousCursor;
+  };
+}
