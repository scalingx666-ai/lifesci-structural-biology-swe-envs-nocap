diff --git a/.github/workflows/docs.yaml b/.github/workflows/docs.yaml
new file mode 100644
index 00000000..e12bc375
--- /dev/null
+++ b/.github/workflows/docs.yaml
@@ -0,0 +1,66 @@
+name: docs
+
+# Builds the Sphinx docs on every PR and deploys them to GitHub Pages
+# (graphein.ai) on pushes to master.
+on:
+  push:
+    branches: [master]
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# Cancel superseded PR builds; let master builds and deployments finish.
+concurrency:
+  group: docs-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+      - name: Install uv
+        uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5.4.2
+        with:
+          python-version: "3.12"
+          enable-cache: true
+      # nbsphinx converts the notebooks with pandoc
+      - name: Install pandoc
+        run: sudo apt-get install -y pandoc
+      - name: Install Graphein and dependencies
+        run: uv sync --locked --extra docs --extra extras
+      # autodoc imports every module: graphein.ml and graphein.protein.tensor
+      # need torch and PyG, and foldcomp_dataset needs lightning
+      - name: Install PyTorch
+        run: uv pip install torch==2.8.0 -f https://download.pytorch.org/whl/cpu
+      - name: Install PyG and Lightning
+        run: uv pip install --no-build torch_geometric==2.7.0 lightning
+      # Notebooks are rendered from their saved outputs rather than re-run
+      - name: Build docs
+        run: >-
+          uv run --no-sync sphinx-build -b html -j auto
+          -D nbsphinx_execute=never
+          docs/source docs/build/html
+      - name: Upload Pages artifact
+        if: github.event_name != 'pull_request'
+        uses: actions/upload-pages-artifact@v3
+        with:
+          path: docs/build/html
+
+  deploy:
+    if: github.event_name != 'pull_request' && github.ref == 'refs/heads/master'
+    needs: build
+    runs-on: ubuntu-latest
+    permissions:
+      pages: write
+      id-token: write
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - name: Deploy to GitHub Pages
+        id: deployment
+        uses: actions/deploy-pages@v4
diff --git a/CHANGELOG.md b/CHANGELOG.md
index da35aaa2..87537aef 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -17,6 +17,7 @@
 
 #### Misc
 
+* Build the docs with a GitHub Actions workflow (`.github/workflows/docs.yaml`) on every PR and deploy them to GitHub Pages on pushes to `master`, replacing manual pushes to the `gh-pages` branch (last updated in 2022). Notebooks are rendered from their saved outputs. Fixes the docs build with Sphinx 9 (`NewTypeDataDocumenter` removed, duplicate intersphinx URLs rejected) and `rdkit.Mol` annotations in `graphein.molecule.graphs` (now `Chem.Mol`), which broke `sphinx_codeautolink`.
 * Remove `.gitattributes`, whose only rule (`export-subst` for versioneer's `graphein/_version.py`) targeted a file deleted in [#276](https://github.com/a-r-j/graphein/pull/276).
 * Speed up `graphein.protein.tensor` helpers by replacing per-atom and per-residue tensor loops with single `.tolist()` calls and dict lookups: `to_dataframe` (~6x on 4hhb), `infer_residue_types` and `is_complete_structure` (~7x), `protein_df_to_tensor`, and the sidechain torsion atom indexing used by `sidechain_torsion`. Output is unchanged. Adds tests for `is_complete_structure` and `has_complete_residue`. [#472](https://github.com/a-r-j/graphein/pull/472)
 * Drop support for Python 3.10, which has reached end of life. Minimum supported version is now Python 3.11.
