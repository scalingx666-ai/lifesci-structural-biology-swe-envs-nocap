+                        ca.push_back(readStructure.ca[resIdx1[i]]);
+                        n.push_back(readStructure.n[resIdx1[i]]);
+                        c.push_back(readStructure.c[resIdx1[i]]);
+                        cb.push_back(readStructure.cb[resIdx1[i]]);
