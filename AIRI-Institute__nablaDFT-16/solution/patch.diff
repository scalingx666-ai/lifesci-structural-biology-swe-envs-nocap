-    def _deblob(self, buf, dtype=np.float32, shape=None):
-        """Convert blob/buffer object to numpy array."""
-        if buf is None:
-            return np.zeros(shape)
-
-        array = np.frombuffer(buf, dtype)
-        if not np.little_endian:
-            array = array.byteswap()
-
-        array.shape = shape
-        return array
