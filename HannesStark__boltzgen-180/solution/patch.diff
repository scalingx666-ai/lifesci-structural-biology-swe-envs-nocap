+            parse_residue_constraints(spec, 10, CANONICAL, LETTER_MAP)
+
+    def test_invalid_amino_acid_in_disallowed(self):
+        spec = [{"position": 1, "disallowed": "XZ"}]
+        with pytest.raises(ValueError, match="Unknown amino acid"):
+            parse_residue_constraints(spec, 10, CANONICAL, LETTER_MAP)
