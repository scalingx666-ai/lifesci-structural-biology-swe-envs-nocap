+                    pool,
+                    completed,
+                    pending,
+                    func,
+                    submitted,
+                    item,
+                )
+                submitted += 1
+                outstanding += 1
+            if not outstanding:
+                break
+            index, callback_succeeded, value = _wait_pool_result(
+                pool,
+                completed,
+                known_workers,
+                task_events,
+                active_tasks,
