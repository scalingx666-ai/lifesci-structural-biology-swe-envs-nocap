+            if not succeeded:
+                if isinstance(value, BaseException):
+                    raise value
+                raise RuntimeError("run_mp worker failed without an exception")
+            yield value
+            outstanding -= 1
+        return
+
+    assert ordered_total is not None
+    next_index = 0
+    source_exhausted = False
