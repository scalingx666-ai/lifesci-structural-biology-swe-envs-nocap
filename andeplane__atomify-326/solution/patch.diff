+        .getActions()
+        .setModifierSyncDataPoints({ name: "missing", type: "variable", value: true });
+
+      expect(store.getState().variables).toEqual({});
+    });
+  });
+
+  describe("reset", () => {
+    it("should revert all fields to defaults", () => {
