+    <body>
+       
+        <div id="divId" style="display:none;" ></div>
+        <script src="../../build/3Dmol.js"></script> 
+			<div id="left">
+
+        	</div>
+        	<div id="right">
+
+        	</div>
+        	
+         <script>
+
+         var test_count=1;
+         var right=document.getElementById("right");
+         var left=document.getElementById("left");
+        
+         for(var i=1;i<=test_count;i++){
+         	//creates the list element
+         	var li = document.createElement("li");
+
+         	//loads the title
+         	var title = document.createElement("h4");
+            title.style.position="absolute";
+            title.style.margin="0 auto";
+
+         	title.align="center";
+
+         	var text= document.createTextNode("Test "+i);
+
+         	title.appendChild(text);
+
+         	li.appendChild(title)
+         	//loads the image
+         	var img = document.createElement("img");
+         	img.class = "test"+i;
+         	img.src = "imgs/test"+i+".png";
+         	img.ondragstart = function() { return false;}
+         	li.appendChild(img);
+
+         	right.appendChild(li);
+				
+         }
+         for(var i=1;i<=test_count;i++){
+            var img= new Image();
+
+            var li= document.createElement('li');
+            li.id=i;
+            li.appendChild(img);
+
+            left.appendChild(li);
+
+            $('#divId').load("test"+i+".html",function(){
+                viewer.render();
+                img.src=document.getElementsByTagName('canvas')[0].toDataURL('image/png');
+            });
+
+         }
+         </script>
+    </body>
+</html>
