+* {
+	margin: 0;
+	padding: 0;
+    font-family: Futura, "Trebuchet MS", Arial, sans-serif;
+}
+
+
+.ui-widget-content {
+    height: 100%;
+    width: 0;
+    position: fixed;
+    z-index: 1;
+    top: 0;
+    left: 0;
+    background-color: rgba(0,0,0,.5);
+    overflow: hidden;
+    transition: 0.5s;
+    padding:0;
+    text-align:center;
+}
+li{
+    height:20%;
+    margin:10px;
+    padding:4px;
+    background-color:#f2f2f2;
+    border-radius: 15px;
+}
+#selections{
+    height:67%;
+}
+
+h1,h3{
