@@ -276,6 +276,8 @@ def _add_padding_row(
     nbmat: Tensor,
     shifts: Tensor | None,
     N: int,
+    *,
+    sort: bool = False,
 ) -> tuple[Tensor, Tensor | None]:
     """Add padding row to neighbor matrix and shifts.
 
@@ -287,12 +289,20 @@ def _add_padding_row(
         Shift vectors for PBC or None, shape (N, max_neighbors, 3).
     N : int
         Number of atoms (used as fill value for padding row).
+    sort : bool
+        Put each row in canonical order first: ascending neighbor index, ties
+        between periodic images broken by shift, fill entries last with zero
+        shift. The CUDA neighbor-list kernels assign slots with atomics, so
+        without this the slot order, and with it the summation order
+        downstream, varies from run to run.
 
     Returns
     -------
     tuple[Tensor, Tensor | None]
         Tuple of (nbmat, shifts) with padding row added.
     """
+    if sort:
+        nbmat, shifts = _sort_neighbor_rows(nbmat, shifts, N)
     device = nbmat.device
     dtype = nbmat.dtype
     nnb_max = nbmat.shape[1]
@@ -306,6 +316,21 @@ def _add_padding_row(
     return nbmat, shifts
 
 
+def _sort_neighbor_rows(nbmat: Tensor, shifts: Tensor | None, N: int) -> tuple[Tensor, Tensor | None]:
+    """Sort each neighbor row by (index, shift_x, shift_y, shift_z)."""
+    if shifts is None:
+        return torch.sort(nbmat, dim=1).values, None
+    # Fill slots carry arbitrary shifts; zero them so equal rows sort equally.
+    shifts = shifts.masked_fill((nbmat == N).unsqueeze(-1), 0)
+    # Lexicographic order via stable argsorts, least significant key first.
+    order = torch.argsort(shifts[..., 2], dim=1, stable=True)
+    for key in (shifts[..., 1], shifts[..., 0], nbmat):
+        order = order.gather(1, torch.argsort(key.gather(1, order), dim=1, stable=True))
+    nbmat = nbmat.gather(1, order)
+    shifts = shifts.gather(1, order.unsqueeze(-1).expand(-1, -1, 3))
+    return nbmat, shifts
+
+
 def maybe_pad_dim0(a: Tensor, N: int, value=0.0) -> Tensor:
     _shape_diff = N - a.shape[0]
     assert _shape_diff == 0 or _shape_diff == 1, "Invalid shape"
diff --git a/docs/calculator.md b/docs/calculator.md
index 15b87ab..beb00f9 100644
--- a/docs/calculator.md
+++ b/docs/calculator.md
@@ -277,12 +277,23 @@ Route external DFT-D3 (and DSF Coulomb) through their differentiable pure-torch
 
 The kernel defaults accumulate pairwise terms with atomic adds, so repeated identical evaluations differ at the float32 rounding level (~1e-7 eV in energies). That noise is physically negligible but is amplified chaotically by iterative optimizers: batched geometry optimizations from byte-identical inputs can follow different trajectories. With `deterministic=True`, identical inputs give bitwise-identical energies and forces on the same machine and build **on the dense layout only**, at negligible cost for typical batched workloads.
 
-The dense layout is used on CUDA for 3D input with at most `nb_threshold` atoms per system (default 120), no `cell`, no Hessian, and no caller-supplied `mol_idx` or `nbmat`. Everything else runs on the packed neighbor-list layout, which `deterministic=True` does not yet make reproducible on CUDA: its neighbor-list row order, per-molecule reductions, and the ConvSV backward kernel still accumulate in varying order, leaving run-to-run noise of about 1e-6 eV/Å in forces ([#140](https://github.com/isayevlab/aimnetcentral/issues/140)). CPU evaluations always use the packed layout; they have been bitwise repeatable in testing, but that is not yet guaranteed.
+The dense layout is used on CUDA for 3D input with at most `nb_threshold` atoms per system (default 120), no `cell`, no Hessian, and no caller-supplied `mol_idx` or `nbmat`. Everything else runs on the packed neighbor-list layout. There, `deterministic=True` sorts each row of the neighbor lists the calculator builds into a canonical order (a caller-supplied `nbmat` is used in the order given), which makes energies bitwise reproducible on CUDA once PyTorch's deterministic mode is also on; without it a one-time `UserWarning` fires. Forces on the packed layout are not yet covered: the ConvSV backward kernel still accumulates in varying order, leaving run-to-run noise of about 1e-6 eV/Å ([#140](https://github.com/isayevlab/aimnetcentral/issues/140)). CPU evaluations always use the packed layout; they have been bitwise repeatable in testing, but that is not yet guaranteed.
 
 ```python
 calc = AIMNet2Calculator("aimnet2", deterministic=True)
 ```
 
+For reproducible energies on the packed layout, enable PyTorch's deterministic mode as well. It is process-wide, so the calculator leaves that choice to you:
+
+```python
+import os
+
+os.environ["CUBLAS_WORKSPACE_CONFIG"] = ":4096:8"  # before CUDA is first used
+torch.use_deterministic_algorithms(True)  # or (True, warn_only=True) without the variable
+```
+
+PyTorch's deterministic reductions are slower; in one measurement on an L40S they roughly doubled the cost of an energy-and-forces call for a batch of 32 molecules, so benchmark your workload.
+
 Notes:
 
 - Covers external D3 and `simple`/`dsf` Coulomb. Ewald/PME kernels are not covered; a one-time `UserWarning` fires if combined.
