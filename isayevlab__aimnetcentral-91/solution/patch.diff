+def test_save_h5_roundtrip(tmp_path):
+    ds = dataset()
+    out = tmp_path / "roundtrip.h5"
+    ds.save_h5(str(out))
+    ds2 = SizeGroupedDataset(str(out))
+    assert sorted(ds2.keys()) == sorted(ds.keys())
+    assert len(ds2) == len(ds)
+    assert sorted(ds2.datakeys()) == sorted(ds.datakeys())
