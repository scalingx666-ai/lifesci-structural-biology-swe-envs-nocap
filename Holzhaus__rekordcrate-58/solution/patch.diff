diff --git a/.gitlint b/.gitlint
new file mode 100644
index 00000000..0a9456bf
--- /dev/null
+++ b/.gitlint
@@ -0,0 +1,14 @@
+[general]
+# Allow commit messaged without body.
+ignore=body-is-missing
+# Enforce conventional commit message-style
+contrib=contrib-title-conventional-commits
+
+[contrib-title-conventional-commits]
+# Specify allowed commit types. For details see: https://www.conventionalcommits.org/
+types=fix,feat,chore,docs,style,refactor,perf,test,revert,ci,build
+
+[ignore-body-lines]
+# Indented lines are ignored (they may be longer than body-line-length for
+# example).
+regex=^    (.*)
diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
index 37e80b4c..a6e1284e 100644
--- a/.pre-commit-config.yaml
+++ b/.pre-commit-config.yaml
@@ -54,3 +54,7 @@ repos:
   rev: bf6c583d7d76d9c5e0de7e6ab00f7e7452c3f9f6
   hooks:
   - id: sourceheaders
+- repo: https://github.com/jorisroovers/gitlint
+  rev: v0.17.0
+  hooks:
+  - id: gitlint
