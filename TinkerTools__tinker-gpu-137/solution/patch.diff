+/**
+ * \ingroup cuda_syntax
+ * Launch a non-blocking CUDA kernel with 0 dynamic shared memory.
+ * \see launch_k4b
+ */
+template <class K, class... Ts>
+void launch_k2b(cudaStream_t st, int bs, int np, K k, Ts&&... a)
+{
+   const size_t sh = 0;
+   launch_k4b(st, sh, bs, np, k, std::forward<Ts>(a)...);
+}
+
+
 /**
