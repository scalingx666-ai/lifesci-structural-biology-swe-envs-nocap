diff --git a/examples/docking-protein-ligand/docking-protein-ligand-autotoppar-full.cfg b/examples/docking-protein-ligand/docking-protein-ligand-autotoppar-full.cfg
new file mode 100644
index 0000000000..9af5ede325
--- /dev/null
+++ b/examples/docking-protein-ligand/docking-protein-ligand-autotoppar-full.cfg
@@ -0,0 +1,69 @@
+# ====================================================================
+# Protein-ligand docking example
+
+# directory in which the scoring will be done
+run_dir = "run1-autotoppar-full"
+
+# execution mode
+mode = "local"
+ncores = 50
+
+# molecules to be docked
+molecules =  [
+    "data/neuraminidase-2BAT.pdb",
+    "data/oseltamivir_zwitterion.pdb"
+    ]
+
+# ====================================================================
+# Parameters for each stage are defined below
+# ====================================================================
+[topoaa]
+autohis = true
+delenph = false
+autotoppar = true
+
+[rigidbody]
+tolerance = 20
+ambig_fname = "data/ambig-active-rigidbody.tbl"
+w_vdw = 1.0
+
+[caprieval]
+reference_fname = 'data/target.pdb'
+
+[seletop]
+
+[caprieval]
+reference_fname = 'data/target.pdb'
+
+[flexref]
+tolerance = 20
+ambig_fname = "data/ambig-passive.tbl"
+mdsteps_rigid = 0
+mdsteps_cool1 = 0
+
+[caprieval]
+reference_fname = 'data/target.pdb'
+
+[ilrmsdmatrix]
+
+[clustrmsd]
+criterion = 'distance'
+linkage = 'average'
+min_population = 4
+clust_cutoff = 1.5
+
+[seletopclusts]
+top_models = 4
+
+[caprieval]
+reference_fname = 'data/target.pdb'
+
+# Running final caprieval with allatoms parameter set to true to also
+#  include the evaluation of protein side chains
+#  in both the alignment process and irmsd, ilrmsd computations
+# NOTE that all ligand atoms are always considered even without this option.
+[caprieval]
+allatoms = true
+reference_fname = "data/target.pdb"
+
+# ====================================================================
