+    namespace detail{
+      template<class ComplexContainer>
+      auto getZeroModeChebCoeff(const ComplexContainer &fourierChebGridData, int3 n){
+	  std::vector<complex> chebCoeff(n.z);
+	  for(int i=0;i<n.z;i++){
+		chebCoeff[i] = fourierChebGridData[(n.x/2+1)*n.y*i]/(n.x*n.y);
+	  }
+	 return chebCoeff;
+      }   
+    }
