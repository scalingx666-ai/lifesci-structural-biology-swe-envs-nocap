diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
new file mode 100644
index 0000000..32872f2
--- /dev/null
+++ b/.github/workflows/publish.yml
@@ -0,0 +1,45 @@
+name: Publish PyPi package for all platforms
+run-name: ${{ github.actor }} testing freesasa-python
+on:
+  release:
+    types: [published]
+jobs:
+  Publish:
+    env:
+      USE_CYTHON: 1
+    strategy:
+      matrix:
+        os: [macos-latest, windows-latest, ubuntu-latest]
+        python-version: ["3.7", "3.8", "3.9", "3.10"]
+    runs-on: ${{ matrix.os }}
+    steps:
+      - name: "Check out code"
+        uses: actions/checkout@v3
+      - name: "Get upstream C library"
+        run: git submodule update --init
+      - name: Set up Python ${{ matrix.python-version }}
+        uses: actions/setup-python@v4
+        with:
+          cache: "pip"
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements.txt
+          pip install build
+      - name: Run tests
+        env:
+          USE_CYTHON: 1
+        run: python setup.py test
+      - name: Build package
+        run: python -m build
+      - name: Build MacOS wheel
+        run: python setup.py bdist_wheel
+      - name: Build sdist
+        # same source for all versions
+        if: ${{ matrix.os == 'ubuntu-latest' && matrix.python.version == '3.10' }}
+        run: python setup.py sdist
+      - name: Publish package
+        uses: pypa/gh-action-pypi-publish@27b31702a0e7fc50959f5ad993c78deac1bdfc29
+        with:
+          user: __token__
+          password: ${{ secrets.PYPI_API_TOKEN }}
diff --git a/.github/workflows/test-push.yml b/.github/workflows/test-push.yml
new file mode 100644
index 0000000..d1db597
--- /dev/null
+++ b/.github/workflows/test-push.yml
@@ -0,0 +1,25 @@
+name: Run tests
+run-name: ${{ github.actor }} testing freesasa-python
+on: push
+jobs:
+  Test:
+    env:
+      USE_CYTHON: 1
+    runs-on: ubuntu-latest
+    steps:
+      - name: "Check out code"
+        uses: actions/checkout@v3
+      - name: "Get upstream C library"
+        run: git submodule update --init
+      - name: Set up Python ${{ matrix.python-version }}
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.10"
+          cache: "pip"
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements.txt
+          python setup.py install
+      - name: Run tests
+        run: python setup.py test
