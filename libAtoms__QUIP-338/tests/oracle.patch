+# compilers explicitly pointing to gcc-10
+# these are pre-installed in the GitHub Actions ubuntu image!
+F77=gfortran-10
+F90=gfortran-10
+F95=gfortran-10
+CC=gcc-10
+CPLUSPLUS=g++-10
+
+MATH_LINKOPTS=-llapack -lblas
+EXTRA_LINKOPTS=
+HAVE_CP2K=0
+HAVE_VASP=0
+HAVE_TB=1
+HAVE_PRECON=0
+HAVE_LOTF=0
+HAVE_ONIOM=0
+HAVE_LOCAL_E_MIX=0
+HAVE_QC=1
+HAVE_QR=1
+HAVE_THIRDPARTY=0
+HAVE_FX=0
+HAVE_SCME=0
+HAVE_MTP=0
+HAVE_MBD=0
+HAVE_TTM_NF=0
+HAVE_CH4=0
+HAVE_NETCDF4=0
+HAVE_MDCORE=0
+HAVE_ASAP=0
+HAVE_CGAL=0
+HAVE_METIS=0
+HAVE_LMTO_TBE=0
+SIZEOF_FORTRAN_T=2
+PIP=pip3
+PYTHON=python3
+QUIPPY_LIBS=
