+        N, M = grad.shape
+        states = torch.zeros(max(N, M))
+        T = max(N, M)
+        i, j = N - 1, M - 1
+        states = [(i, j)]
+        for t in reversed(range(T)):
+            idx = torch.Tensor([
+                [i - 1, j],
+                [i - 1, j - 1],
+                [i, j - 1]
+            ]).long()
+            ij = torch.argmax(
+                   torch.Tensor([
