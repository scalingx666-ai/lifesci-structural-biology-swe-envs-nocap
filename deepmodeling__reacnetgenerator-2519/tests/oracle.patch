+        previous = tempfile.tempdir
+        tempfile.tempdir = folder
+        try:
+            result = sample(args, Path(folder))
+        finally:
+            tempfile.tempdir = previous
+    print(json.dumps(result, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()
