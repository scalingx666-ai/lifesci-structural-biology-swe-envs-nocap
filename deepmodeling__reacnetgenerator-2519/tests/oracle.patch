+    before = _usage()
+    started = time.perf_counter()
+    if args.stage == "full":
+        rng.run()
+    elif args.stage == "path":
+        collector.collect()
+    else:
+        with _timedoutput._TimedOutputWriter(rng) as writer:
+            writer.write_molecules(rng.mname)
