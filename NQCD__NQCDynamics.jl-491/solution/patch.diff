+end
+function OutputSurfaceSiteClassification(slab_info::Analysis.HighSymmetrySites.SlabStructure; fractional=false, snap_to_sites=0.03)
+    return OutputSurfaceSiteClassification(
+        slab_info,
+        fractional,
+        snap_to_sites
+    )
