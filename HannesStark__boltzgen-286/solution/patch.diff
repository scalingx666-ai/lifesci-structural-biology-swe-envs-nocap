+) -> None:
+    source = parse_entities(
+        tmp_path,
+        [
+            {"protein": {"id": "A", "sequence": "GGG"}},
+            {"ligand": {"id": "L", "smiles": "CC"}},
+        ],
+    ).structure
+    tokenized = Tokenizer().tokenize(source)
+    cropper = MultimerCropper([3])
+    if first_method == "normal":
+        first = cropper.crop(
+            tokenized,
+            max_tokens=4,
+            random=np.random.default_rng(0),
+            initial_crop=[1, 2, 3, 4],
