+        let y_min = 0.0_f64;
+        let x_max = (self.width as f64) - 1.0;
+        let y_max = (self.height as f64) - 1.0;
+
+        let outcode = |x: f64, y: f64| -> u8 {
+            let mut code = INSIDE;
+            if x < x_min { code |= LEFT; }
+            else if x > x_max { code |= RIGHT; }
+            if y < y_min { code |= TOP; }
+            else if y > y_max { code |= BOTTOM; }
