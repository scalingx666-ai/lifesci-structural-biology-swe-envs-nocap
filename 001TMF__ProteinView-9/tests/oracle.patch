+        loop {
+            if (code0 | code1) == INSIDE {
+                // Both inside — accept
+                return Some(([x0, y0, z0], [x1, y1, z1]));
+            }
+            if (code0 & code1) != INSIDE {
+                // Both on same side — trivial reject
+                return None;
+            }
