+    """Forward and backward queries must agree with uncached scalar searches."""
+    monkeypatch.setattr(ranges, "_MOLECULE_BOUND_CACHE_ENTRIES", 3)
+    ids = np.repeat(np.arange(1, 6), 75)
+    starts = np.tile(np.arange(75) * 4, 5)
