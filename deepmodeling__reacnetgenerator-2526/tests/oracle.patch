+        assert writer._participant_atoms([2]) == {1}
+    rng.timed_output = str(tmp_path / "other.h5")
+    with _TimedOutputWriter(rng) as writer:
+        _append_metadata_molecules(writer, atom_start=10)
+        assert writer._participant_atoms([1]) == {10}
