+            mid, frame, ids, starts, ends
+        )
+        assert len(lookup._windows) <= 3
+        assert (
+            sum(a.nbytes + b.nbytes for *_, a, b in lookup._windows.values())
+            <= 3 * block_rows * 16
+        )
