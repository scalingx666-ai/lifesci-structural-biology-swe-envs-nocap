+    def _combine_many_mols_tree(cls, mols):
+        r"""tree-like compbination of mols iterable (nlog(n) cost).
+
+            mols: 
+            (a,b)   (c,d)
+              \       /
+               (ab, cd)
+                   |
+                 abcd   
+
+        """
+        mols = list(mols)
+        if not mols:
+            return Chem.Mol()
+        while len(mols) > 1:
+            nxt = []
+            it = iter(mols)
+            for a in it:
+                b = next(it, None)
+                nxt.append(Chem.CombineMols(a, b) if b is not None else a)
+            mols = nxt
+        return mols[0]
