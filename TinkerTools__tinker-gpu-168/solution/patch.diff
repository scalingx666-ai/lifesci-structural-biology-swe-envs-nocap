diff --git a/include/seq_pair_vlambda.h b/include/seq_pair_vlambda.h
new file mode 100644
index 000000000..78f7da9c3
--- /dev/null
+++ b/include/seq_pair_vlambda.h
@@ -0,0 +1,22 @@
+#pragma once
+#include "mod.vdwpot.h"
+#include "seq_def.h"
+#include "seq_switch.h"
+
+
+namespace tinker {
+/**
+ * \ingroup vdw
+ */
+SEQ_ROUTINE
+inline real pair_vlambda(real vlam, evdw_t vcouple, int imut, int kmut)
+{
+   real vlambda = 1;
+   if (vcouple == evdw_t::decouple) {
+      vlambda = (imut == kmut ? 1 : vlam);
+   } else if (vcouple == evdw_t::annihilate) {
+      vlambda = (imut || kmut ? vlam : 1);
+   }
+   return vlambda;
+}
+}
