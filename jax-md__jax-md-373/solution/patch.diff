+      @jax.jit
+      def build_fn(pos):  # pos: [N, dim]
+        return _build_neighbor_list_sparse(
+          pos,
+          box,
+          shifts,
+          shifts_real,
+          zero_shift_idx,
+          search_cutoff,
+          capacity,
+          fractional_coordinates,
+          update_fn_ref[0],
