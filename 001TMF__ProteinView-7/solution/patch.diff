+/// Render non-covalent interaction lines as dashed segments in the framebuffer.
+fn render_interactions_fb(
+    fb: &mut Framebuffer,
+    interactions: &[Interaction],
+    camera: &Camera,
+    half_w: f64,
+    half_h: f64,
+) {
