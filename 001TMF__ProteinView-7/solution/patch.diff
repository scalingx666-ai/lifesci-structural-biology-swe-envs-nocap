+        let px1 = to_pixel(p1.x, p1.y, p1.z, half_w, half_h);
+        let px2 = to_pixel(p2.x, p2.y, p2.z, half_w, half_h);
+        let color = interaction_color(interaction.interaction_type);
+        fb.draw_dashed_line_3d(px1, px2, color, 4.0, 3.0);
+    }
