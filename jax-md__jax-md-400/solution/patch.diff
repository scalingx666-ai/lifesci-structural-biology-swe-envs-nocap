+  grad_y_value = _zero_if_undefined(grad_y)
+  weights_value = _zero_if_undefined(weights)
+  tg_value = _zero_if_undefined(tg)
+  tw_value = _zero_if_undefined(tw)
+  grad_grad_y = None
+  grad_weights = None
+  grad_tg = None
+  grad_tw = None
+  if ad.is_undefined_primal(grad_y):
