@@ -0,0 +1,23 @@
+#!/bin/bash
+
+set -e
+
+if [ -z $QUIP_ARCH ]; then
+   echo "$0: Need QUIP_ARCH defined"
+   exit 1
+fi
+
+mydir=`dirname $0`
+bindir=$mydir/../build/$QUIP_ARCH
+QUIP_ROOT=${mydir}/..
