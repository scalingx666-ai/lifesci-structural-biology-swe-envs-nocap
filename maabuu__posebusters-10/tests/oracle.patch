+    columns = test_columns + extra_columns if full_report else test_columns
+
+    df[missing_columns] = pd.NA
+    df = df[columns]
+    df.columns = [names_lookup.get(c, c[-1] + suffix_lookup.get(c[0], "")) for c in df.columns]
+
+    return df
