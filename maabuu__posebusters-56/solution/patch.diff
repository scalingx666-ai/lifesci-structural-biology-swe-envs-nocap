index 2ec1752..edeec20 100644
--- a/posebusters/config/dock.yml
+++ b/posebusters/config/dock.yml
@@ -67,6 +67,26 @@ modules:
       max_distance: aromatic_ring_maximum_distance_from_plane
       flatness_passes: "Aromatic ring flatness"
 
+  - name: "Ring non-flatness"
+    function: "flatness"
+    parameters:
+      check_nonflat: True
+      flat_systems: # list atoms which together should definitely not lie on plane as SMARTS matches
+        "non-aromatic_5_membered_rings": "[C,O,S,N]~1[C,O,S,N][C,O,S,N][C,O,S,N][C,O,S,N]1"
+        "non-aromatic_6_membered_rings": "[C,O,S,N]~1[C,O,S,N][C,O,S,N][C,O,S,N][C,O,S,N][C,O,S,N]1"
+        "non-aromatic_6_membered_rings_db03_0": "[C]~1[C][C,O,S,N]~[C,O,S,N][C][C]1"
+        "non-aromatic_6_membered_rings_db03_1": "[C]~1[C][C]~[C][C,O,S,N][C]1"
+        "non-aromatic_6_membered_rings_db02_0": "[C]~1[C][C][C,O,S,N]~[C,O,S,N][C]1"
+        "non-aromatic_6_membered_rings_db02_1": "[C]~1[C][C,O,S,N][C]~[C][C]1"
+      threshold_flatness: 0.05 # minimally required distance in A of at least one atom from the closest shared plane
+    chosen_binary_test_output:
+      - flatness_passes
+    rename_outputs:
+      num_systems_checked: number_non-aromatic_rings_checked
+      num_systems_passed: number_non-aromatic_rings_pass
+      max_distance: non-aromatic_ring_maximum_distance_from_plane
+      flatness_passes: "Non-aromatic ring non-flatness"
+
   - name: "Double bond flatness"
     function: "flatness"
     parameters:
