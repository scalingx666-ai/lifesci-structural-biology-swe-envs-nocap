diff --git a/.github/workflows/nf-test-gpu.yml b/.github/workflows/nf-test-gpu.yml
new file mode 100644
index 00000000..7c2c535f
--- /dev/null
+++ b/.github/workflows/nf-test-gpu.yml
@@ -0,0 +1,125 @@
+name: Run GPU nf-tests
+on:
+  push:
+    branches: [dev]
+    paths:
+      - "conf/test.config"
+      - "conf/test_nostub.config"
+      - "modules/local/colabfold_batch/**"
+      - "modules/local/run_boltz/**"
+  release:
+    types: [published]
+  workflow_dispatch:
+
+# Cancel if a newer run is started
+concurrency:
+  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+env:
+  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+  # renovate: datasource=github-releases depName=askimed/nf-test versioning=semver
+  NFT_VER: "0.9.4"
+  NFT_WORKDIR: "~"
+  NXF_ANSI_LOG: false
+  NXF_SINGULARITY_CACHEDIR: ${{ github.workspace }}/.singularity
+  NXF_SINGULARITY_LIBRARYDIR: ${{ github.workspace }}/.singularity
+
+jobs:
+  get-shards:
+    runs-on:
+      - runs-on=${{ github.run_id }}-nf-test-get-shards-gpu
+      - runner=2cpu-linux-x64
+    name: "Get Shards"
+    outputs:
+      shard: ${{ steps.set-shards.outputs.shard }}
+      total_shards: ${{ steps.set-shards.outputs.total_shards }}
+    steps:
+      - name: Check out pipeline code
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
+        with:
+          fetch-depth: 0
+
+      - name: run nf-test-shard action
+        id: set-shards
+        uses: ./.github/actions/get-shards
+        env:
+          NFT_VER: ${{ env.NFT_VER }}
+          SKIP_SCIENTIFIC: "true"
+        with:
+          tags: "gpu"
+          max_shards: 2
+
+      - name: Set outputs
+        id: set-outputs
+        run: |
+          echo "shard=${{ steps.set-shards.outputs.shard }}" >> $GITHUB_ENV
+          echo "total_shards=${{ steps.set-shards.outputs.total_shards }}" >> $GITHUB_ENV
+
+  nf-test-gpu:
+    needs: [get-shards]
+    runs-on: "runs-on=${{ github.run_id }}/family=g5.xlarge/image=ubuntu24-gpu-x64"
+    name: "GPU Test | ${{ matrix.profile }} | ${{ matrix.shard }} | ${{ matrix.NXF_VER }} | ${{ matrix.filters }}"
+    env:
+      NXF_VER: ${{ matrix.NXF_VER }}
+
+    # Only run if number of shards is greater than 0
+    if: ${{ needs.get-shards.outputs.total_shards > 0 }}
+    strategy:
+      fail-fast: false
+      matrix:
+        profile: [docker, singularity]
+        isMain:
+          - ${{ github.base_ref == 'master' || github.base_ref == 'main' }}
+        # # Exclude singularity on dev
+        exclude:
+          - isMain: false
+            profile: "singularity"
+        shard: ${{ fromJson(needs.get-shards.outputs.shard) }}
+        NXF_VER:
+          - "25.10.4"
+        filters: [pipeline]
+
+    steps:
+      - name: Check out pipeline code
+        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd # v6
+        with:
+          fetch-depth: 0
+
+      - name: Test CUDA
+        run: |
+          nvidia-smi -L
+
+      - name: Run nf-test Action
+        uses: ./.github/actions/nf-test
+        with:
+          profile: test_nostub,${{ matrix.profile }},gpu
+          shard: ${{ matrix.shard }}
+          total_shards: ${{ needs.get-shards.outputs.total_shards }}
+          filters: ${{ matrix.filters }}
+          tags: "gpu"
+
+  confirm-pass-gpu:
+    runs-on:
+      - runs-on=${{ github.run_id }}-confirm-pass
+      - runner=2cpu-linux-x64
+    needs: [nf-test-gpu]
+    if: always()
+    steps:
+      - name: One or more tests failed
+        if: ${{ contains(needs.*.result, 'failure') }}
+        run: exit 1
+
+      - name: One or more tests cancelled
+        if: ${{ contains(needs.*.result, 'cancelled') }}
+        run: exit 1
+
+      - name: All tests ok
+        if: ${{ contains(needs.*.result, 'success') }}
+        run: exit 0
+
+      - name: debug-print
+        if: always()
+        run: |
+          echo "toJSON(needs) = ${{ toJSON(needs) }}"
+          echo "toJSON(needs.*.result) = ${{ toJSON(needs.*.result) }}"
