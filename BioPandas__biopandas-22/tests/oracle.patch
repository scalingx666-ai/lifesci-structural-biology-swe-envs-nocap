+        tmp = self.df[record]
+        cmp = 'placeholder'
+        indices = []
+
+        for num, ind in zip(tmp['residue_number'], tmp.index):
+            if num != cmp:
+                indices.append(ind)
+            cmp = num
+
+        transl = tmp.iloc[indices][residue_col].map(
+            amino3to1dict).fillna(fillna)
+
+        return pd.concat((tmp.iloc[indices]['chain_id'], transl), axis=1)
 
