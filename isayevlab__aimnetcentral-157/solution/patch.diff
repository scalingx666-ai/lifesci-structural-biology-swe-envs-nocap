+# A newer push to a PR cancels its running CI. On main, a run in progress
+# finishes and only queued intermediate runs are replaced by the newest one.
+concurrency:
+    group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
+    cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+# CI tiers. A PR runs the bracketing versions (Python 3.11 and 3.14, torch 2.10
+# and 2.15). Pushes to main, manual dispatches, and PRs labeled `ci:full` run
+# the full matrix. Docs-only PRs skip the test jobs, and draft PRs skip them
+# until marked ready. `ci-ok` is the only required status check, so jobs can be
+# skipped or renamed without touching branch protection.
 jobs:
+    changes:
+        if: github.event_name != 'pull_request' || github.event.pull_request.draft == false
+        runs-on: ubuntu-latest
+        timeout-minutes: 5
+        permissions:
+            contents: read
+            pull-requests: read
+        outputs:
+            code: ${{ steps.filter.outputs.code }}
+            full: ${{ steps.filter.outputs.full }}
+        steps:
+            - id: filter
+              env:
+                  GH_TOKEN: ${{ github.token }}
+                  EVENT: ${{ github.event_name }}
+                  PR: ${{ github.event.pull_request.number }}
+                  LABELS: ${{ join(github.event.pull_request.labels.*.name, ',') }}
+              run: |
+                  set -euo pipefail
+                  code=true
+                  full=false
+                  if [ "$EVENT" != "pull_request" ] || [[ ",$LABELS," == *",ci:full,"* ]]; then
+                    full=true
+                  fi
+                  if [ "$EVENT" = "pull_request" ]; then
+                    files=$(gh api "repos/$GITHUB_REPOSITORY/pulls/$PR/files" --paginate --jq '.[].filename')
+                    # Skip the test jobs only when every changed file is documentation.
+                    if ! grep -qvE '^(docs/|README\.md$|CHANGELOG\.md$|CONTRIBUTING\.md$|LICENSE$|mkdocs\.yml$)' <<<"$files"; then
+                      code=false
+                    fi
+                  fi
+                  echo "code=$code full=$full"
+                  echo "code=$code" >> "$GITHUB_OUTPUT"
+                  echo "full=$full" >> "$GITHUB_OUTPUT"
+
+    quality:
