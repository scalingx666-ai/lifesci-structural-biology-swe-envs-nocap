+    """Try to read Alpha carbons based on PDB column-based format"""
+
+    atom_col = line[12:16]
+    atom = atom_col[0:2]
+    atom = re.sub(r"\d", " ", atom)
+    atom = atom.strip()
+    atom = atom.capitalize()
