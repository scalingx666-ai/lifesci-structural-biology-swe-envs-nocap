+                at_pka = True
+            else:
+                m = re.match(
+                    r"The pI is *(\d+\.\d+) .folded. and *(\d+\.\d+) .unfolded.",
+                    line)
+                if m is not None:
+                    data["pI_folded"] = float(m.group(1))
+                    data["pI_unfolded"] = float(m.group(2))
+
+    return data
