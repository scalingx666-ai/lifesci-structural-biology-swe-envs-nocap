+    value = row.get("designed_chain_sequence" if full else "designed_sequence", "")
+    if not isinstance(value, str) or not value:
+        return {}
+    chains = value.split(":")
+    return {str(i) if len(chains) > 1 else "": seq for i, seq in enumerate(chains)}
+
