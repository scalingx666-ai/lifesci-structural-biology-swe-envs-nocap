+            raise ValueError(f"vectors must have trailing shape ({N}, 3); got {tuple(vecs.shape)}")
+
+        outs = []
+        for k in range(vecs.shape[0]):
+            v = vecs[k].to(forces_diff.dtype)
+            v_full = torch.zeros_like(coord)
+            v_full[:N] = v
