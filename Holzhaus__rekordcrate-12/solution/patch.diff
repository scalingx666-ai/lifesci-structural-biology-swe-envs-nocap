+            3 => Self::Hot,
+            4 => Self::Subtle,
+            5 => Self::Warm,
+            6 => Self::Vivid,
+            7 => Self::Club1,
+            8 => Self::Club2,
+            x => Self::Unknown(x),
+        }
+    }
+}
