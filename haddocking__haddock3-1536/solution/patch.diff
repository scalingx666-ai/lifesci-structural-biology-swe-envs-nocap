+++ b/examples/peptide-cyclisation/cyclise-ace-cys-peptide-full.cfg
@@ -0,0 +1,121 @@
+# ==================================================
+#      Peptide cyclisation protocol with HADDOCK3
+#
+#  This example workflow will take a peptide
+#  and generate cyclised conformations in a two step
+#  process, first using distance restraints to bring the 
+#  ACE and CYS together, then rebuilding the topology to
+#  create the covalent cyclic bond and refining again.
+#  50 clusters are generated and the best model of 
+#  each is selected.
+#  
+#  Based on related protocol described in: https://doi.org/10.1021/acs.jctc.2c00075
+# ==================================================
+
+run_dir = "ace-cys-cyclization_step"
+
+# execution mode
+mode = "local"
+ncores = 20
+
+# ensemble of two initial peptide conformations
+molecules = [
+    "data/peptide-ace-cys.pdb",
+    ] 
+
+# ==================================================
+
+[topoaa]
+
+[flexref]
+unambig_fname = "data/ace-cys-unambig.tbl"
+tolerance = 5
+sampling_factor = 400
+tadfactor = 4
+mdsteps_rigid = 2000 
+mdsteps_cool1 = 2000
+mdsteps_cool2 = 4000
+mdsteps_cool3 = 4000
+# give full flexibilit to the peptide
+nfle = 1
+fle_sta_1 = 1
+fle_end_1 = 99
+fle_seg_1 = "B"
+# turn off electrostatic
+elecflag = false
+
+[mdref]
+unambig_fname = "data/ace-cys-unambig.tbl"
+# give full flexibilit to the peptide
+nfle = 1
+fle_sta_1 = 1
+fle_end_1 = 99
+fle_seg_1 = "B"
+
+[caprieval]
+
+[rmsdmatrix]
+
+[clustrmsd]
+criterion = "maxclust"  # Use maximum number of cluster to create clusters
+n_clusters = 50  # Number of desired clusters
+min_population = 1  # Even singlotons will be `clustered`
+plot_matrix = true  # Plot the corresponding matrix
+
+[seletopclusts]
+top_clusters = 50
+top_models = 1
+
+[caprieval]
+
+[topoaa]
+acecys_dist = 4.5
+[topoaa.mol1]
+cyclicpept = true
+
+[emscoring]
+# required to make the next module accept the new PDB files
+# after calling a second time topoaa
+
+[flexref]
+unambig_fname = "data/ace-cys-unambig.tbl"
+tolerance = 5
+sampling_factor = 1
+tadfactor = 4
+mdsteps_rigid = 2000 
+mdsteps_cool1 = 2000
+mdsteps_cool2 = 4000
+mdsteps_cool3 = 4000
+# give full flexibilit to the peptide
+nfle = 1
+fle_sta_1 = 1
+fle_end_1 = 99
+fle_seg_1 = "B"
+# turn off electrostatic
+elecflag = false
+
+[mdref]
+watersteps = 5000
+# give full flexibilit to the peptide
+nfle = 1
+fle_sta_1 = 1
+fle_end_1 = 99
+fle_seg_1 = "B"
+
+[caprieval]
+
+[rmsdmatrix]
+
+[clustrmsd]
+criterion = "maxclust"  # Use maximum number of cluster to create clusters
+n_clusters = 50  # Number of desired clusters
+min_population = 1  # Even singlotons will be `clustered`
+plot_matrix = true  # Plot the corresponding matrix
+
+[seletopclusts]
+top_clusters = 50
+top_models = 1
+
+[caprieval]
+
+# ==================================================
