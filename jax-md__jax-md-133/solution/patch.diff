+      "metadata": {
+        "id": "psqU1uEPWm9T"
+      },
+      "source": [
+        "steps = 40000\n",
+        "\n",
+        "log = {\n",
+        "    'kT': np.zeros((steps,)),\n",
+        "    'P': np.zeros((steps,)),\n",
+        "    'H': np.zeros((steps,)),\n",
