diff --git a/oddt/fingerprints.py b/oddt/fingerprints.py
index 1ebb19f2..1a9b5567 100644
--- a/oddt/fingerprints.py
+++ b/oddt/fingerprints.py
@@ -383,6 +383,7 @@ def _ECFP_atom_repr(mol, idx, use_pharm_features=False):
                 int(atom_dict['isaromatic']))
 
     else:
+        max_ring_size = 10  # dont catch macromolecular rings
         if is_openbabel_molecule(mol):
             atom = mol.OBMol.GetAtom(idx + 1)
             if atom.GetAtomicNum() == 1:
@@ -392,19 +393,27 @@ def _ECFP_atom_repr(mol, idx, use_pharm_features=False):
                     atom.GetHvyValence(),
                     atom.ImplicitHydrogenCount() + atom.ExplicitHydrogenCount(),
                     atom.GetFormalCharge(),
-                    int(atom.IsInRing()),
+                    int(0 < atom.MemberOfRingSize() <= max_ring_size),
                     int(atom.IsAromatic()),)
         else:
             atom = mol.Mol.GetAtomWithIdx(idx)
             if atom.GetAtomicNum() == 1:
                 raise Exception('ECFP should not hash Hydrogens')
             n_hs = atom.GetTotalNumHs(includeNeighbors=True)
+
+            # get ring info for atom and check rign size
+            isring = False
+            if atom.IsInRing():
+                # FIXME: this is not efficient, fixed by rdkit/rdkit#1859
+                isring = any(atom.IsInRingSize(size)
+                             for size in range(3, max_ring_size + 1))
+
             return (atom.GetAtomicNum(),
                     atom.GetIsotope(),
                     atom.GetTotalDegree() - n_hs,
                     n_hs,
                     atom.GetFormalCharge(),
-                    int(atom.IsInRing()),
+                    int(isring),
                     int(atom.GetIsAromatic()),)
 
 
diff --git a/oddt/toolkits/extras/rdkit.py b/oddt/toolkits/extras/rdkit.py
index 1a3e5acc..848669f6 100644
--- a/oddt/toolkits/extras/rdkit.py
+++ b/oddt/toolkits/extras/rdkit.py
@@ -1,6 +1,7 @@
 from __future__ import absolute_import, print_function
 from math import isnan, isinf
 
+import rdkit
 from rdkit import Chem
 from rdkit.Chem import AllChem
 
@@ -55,6 +56,19 @@ def MolFromPDBBlock(molBlock,
                             bond.SetBondType(Chem.BondType.DOUBLE)
                             break
 
+    # Set metal coordination (zero order) bond orders to single to prevent adding Hs
+    if rdkit.__version__ >= '2018.03':
+        for bond in mol.GetBonds():
+            if bond.GetBondType() == Chem.BondType.ZERO:
+                a1 = bond.GetBeginAtom()
+                a2 = bond.GetEndAtom()
+                # single bonds only if there are enough electrons
+                if ((a1.GetAtomicNum() in _metals and
+                     a2.GetNumImplicitHs() + a2.GetNumExplicitHs() > 0) or
+                    (a2.GetAtomicNum() in _metals and
+                     a1.GetNumImplicitHs() + a1.GetNumExplicitHs() > 0)):
+                    bond.SetBondType(Chem.BondType.SINGLE)
+
     if sanitize:
         result = Chem.SanitizeMol(mol)
         if result != 0:
