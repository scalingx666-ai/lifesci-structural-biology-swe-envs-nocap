+        elif raw_or_clean == "clean":
+            pdb_id = "ALA_654321"
+        return """
+        {{
+            "pdb_id": "{pdb_id}",
+            "forcefield_files": ["amber14-all.xml", "amber14/tip3pfb.xml"],
+            "save": true,
+            "system_params":{{
+                "nonbondedMethod": "PME",
