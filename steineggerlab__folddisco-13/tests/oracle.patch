+#[inline]
+fn get_sep_character_from_filename(file: &str) -> char {
+    let ext = file.split('.').last().unwrap();
+    match ext {
+        "csv" => ',',
+        "tsv" | "txt" => '\t',
+        _ => {
+            print_log_msg(WARN, "Unexpected file extension. Using tab as separator");
+            '\t'
+        }
+    }
