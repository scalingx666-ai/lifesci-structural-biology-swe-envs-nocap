+        setColor: vi.fn(),
+      };
+
+      const mockCompute = {
+        isPerAtom: true,
+        lmpCompute: {
+          execute: vi.fn(() => true),
+          sync: vi.fn(),
+          getPerAtomData: vi.fn(() => 0),
+        },
+      };
+
+      const mockWasm = {
+        HEAPF64: {
+          subarray: vi.fn(() => new Float64Array([1.0, 5.0, 10.0])),
