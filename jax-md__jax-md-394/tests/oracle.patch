+  dy7s = plt.load(gout_ref.at[safe_edge, 4, c_offsets], mask=c_mask, other=0.0)
+  dy7t = plt.load(
+    gout_ref.at[safe_edge, 4, channels + c_offsets],
+    mask=c_mask,
