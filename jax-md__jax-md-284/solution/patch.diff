+      "source": [
+        "lammps_step_0 = onp.loadtxt('/content/step_1.traj', dtype=f64)\n",
+        "# Load positions from lammps\n",
+        "positions = jnp.array(lammps_step_0[:,2:5], dtype=f64)\n",
+        "# Load velocities from lammps\n",
+        "velocity = jnp.array(lammps_step_0[:,5:8], dtype=f64)\n",
+        "latvec = jnp.array([[21.724, 0.000000, 0.000000], [0.00000, 21.724, 0.00000],[0.00000, 0.0000, 21.724]])"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "execution_count": null,
+      "metadata": {
+        "id": "GxHGjy5hO-Dz"
+      },
+      "outputs": [],
+      "source": [
+        "# Import unit system\n",
+        "from jax_md import units\n",
+        "\n",
+        "# Metal units\n",
+        "unit = units.metal_unit_system()\n",
+        "\n",
+        "# Simulation parameters\n",
+        "timestep = 1e-3\n",
+        "fs = timestep * unit['time']\n",
+        "ps = unit['time']\n",
+        "dt = fs\n",
+        "write_every = 100\n",
+        "box = latvec\n",
+        "T_init = 300 * unit['temperature']\n",
+        "Mass = 28.0855 * unit['mass']\n",
+        "key = random.PRNGKey(121)\n",
+        "steps = 50000"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "execution_count": null,
+      "metadata": {
+        "id": "vajd8x8xPDxM"
+      },
+      "outputs": [],
+      "source": [
+        "# Logger to save data\n",
+        "log = {\n",
+        "'E': jnp.zeros((steps // write_every,)),\n",
+        "'P': jnp.zeros((steps // write_every,)),\n",
+        "'T': jnp.zeros((steps // write_every,)),\n",
+        "'kT': jnp.zeros((steps // write_every,)),\n",
+        "}"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "execution_count": null,
+      "metadata": {
+        "id": "pHr9jmHJPI2E"
+      },
+      "outputs": [],
+      "source": [
+        "# Setup the periodic boundary conditions.\n",
+        "displacement, shift = space.periodic_general(latvec)\n",
+        "dist_fun = space.metric(displacement)\n",
+        "neighbor_fn, energy_fn = energy.stillinger_weber_neighbor_list(displacement, latvec, disable_cell_list=True)\n",
+        "energy_fn = jit(energy_fn)"
+      ]
+    },
+    {
+      "cell_type": "code",
+      "execution_count": null,
+      "metadata": {
+        "colab": {
