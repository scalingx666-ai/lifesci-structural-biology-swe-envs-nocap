diff --git a/reacnetgenerator/static/webpack/test/test_url.js b/reacnetgenerator/static/webpack/test/test_url.js
new file mode 100644
index 000000000..f11b12fdb
--- /dev/null
+++ b/reacnetgenerator/static/webpack/test/test_url.js
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+const assert = require("assert");
+const {getReportDataUrl} = require("../url");
+
+/** Test report URL query parsing. */
+describe("Report data URL", function() {
+  it("preserves percent escapes in the nested URL", function() {
+    const nestedUrl =
+        "https://example.test/data%25set.json?token=a%2Fb&label=100%25";
+    const search = `?jdata=${encodeURIComponent(nestedUrl)}`;
+
+    assert.equal(getReportDataUrl(search), nestedUrl);
+  });
+
+  it("returns null when jdata is absent",
+     function() { assert.equal(getReportDataUrl("?other=value"), null); });
+});
diff --git a/reacnetgenerator/static/webpack/url.js b/reacnetgenerator/static/webpack/url.js
new file mode 100644
index 000000000..fe3acfd5c
--- /dev/null
+++ b/reacnetgenerator/static/webpack/url.js
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+
+/**
+ * Return the nested report-data URL from a page query string.
+ *
+ * URLSearchParams performs the query decoding exactly once. The returned URL
+ * must not be passed through decodeURIComponent again because percent escapes
+ * may belong to the nested URL itself.
+ *
+ * @param {string} search page query string
+ * @return {string|null} nested report-data URL, if supplied
+ */
+function getReportDataUrl(search) {
+  return new URLSearchParams(search).get("jdata");
+}
+
+module.exports = {getReportDataUrl};
