+
 void fread_array_d_(int *size, double *v, char *filename) {
    FILE *fp;
    int i;
 
    fp = fopen(filename, "r");
    for (i=0; i < *size; i++) {
-      fscanf(fp, "%lf", v+i);
+      int n_read = fscanf(fp, "%lf", v+i);
+      if (i == 0 && n_read <= 0) {
+          // try binary
+          fclose(fp);
+          fp = fopen(filename, "r");
+          fread(v, *size, sizeof(double), fp);
+          break;
+      }
    }
    fclose(fp);
 }
