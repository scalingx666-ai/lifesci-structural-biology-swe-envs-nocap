+++ b/src/utils/scaleBar.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vitest";
+import {
+  niceLength,
+  orthographicUnitsPerPixel,
+  scaleBarSize,
+} from "./scaleBar";
+
+describe("orthographicUnitsPerPixel", () => {
+  it("spreads the frustum height over the viewport height", () => {
+    expect(
+      orthographicUnitsPerPixel({ top: 10, bottom: -10, zoom: 1 }, 400),
+    ).toBe(0.05);
+  });
+
+  it("shrinks with camera zoom", () => {
+    expect(
+      orthographicUnitsPerPixel({ top: 10, bottom: -10, zoom: 4 }, 400),
+    ).toBe(0.0125);
+  });
+
+  it("is undefined for an empty or collapsed viewport", () => {
+    expect(
+      orthographicUnitsPerPixel({ top: 10, bottom: -10, zoom: 1 }, 0),
+    ).toBeUndefined();
+    expect(
+      orthographicUnitsPerPixel({ top: 0, bottom: 0, zoom: 1 }, 400),
+    ).toBeUndefined();
+  });
+});
+
+describe("niceLength", () => {
+  it.each([
+    [1, 1],
+    [1.9, 1],
+    [2, 2],
+    [4.99, 2],
+    [5, 5],
+    [9.99, 5],
+    [10, 10],
+    [12, 10],
+    [37, 20],
+    [1000, 1000],
+    [0.3, 0.2],
+    [0.001, 0.001],
+    [0.0007, 0.0005],
+    [7e-9, 5e-9],
+  ])("rounds %f down to %f", (maxLength, expected) => {
+    expect(niceLength(maxLength)).toBe(expected);
+  });
+});
+
+describe("scaleBarSize", () => {
+  it("picks a round length that fits and sizes the bar to match", () => {
+    // 0.1 Å per pixel allows at most 12 Å in 120 px.
+    expect(scaleBarSize(0.1)).toEqual({ length: 10, widthPx: 100 });
+  });
+
+  it("keeps the bar between 40% and 100% of the maximum width", () => {
+    for (const unitsPerPixel of [0.0013, 0.042, 0.37, 2.9, 61, 840]) {
+      const { widthPx } = scaleBarSize(unitsPerPixel, 120);
+      expect(widthPx).toBeGreaterThanOrEqual(48);
+      expect(widthPx).toBeLessThanOrEqual(120 + 1e-9);
+    }
+  });
+});
diff --git a/src/utils/scaleBar.ts b/src/utils/scaleBar.ts
new file mode 100644
index 00000000..e8c53741
--- /dev/null
+++ b/src/utils/scaleBar.ts
@@ -0,0 +1,38 @@
+/** Longest the scale bar may be drawn, in CSS pixels. */
+export const SCALE_BAR_MAX_WIDTH_PX = 120;
+
+/**
+ * World length covered by one CSS pixel of an orthographic camera's
+ * viewport. The frustum height (top - bottom) spans the viewport height and
+ * zooming in divides it by the camera's zoom.
+ */
+export function orthographicUnitsPerPixel(
+  camera: { top: number; bottom: number; zoom: number },
+  viewportHeightPx: number,
+): number | undefined {
+  const unitsPerPixel =
+    (camera.top - camera.bottom) / camera.zoom / viewportHeightPx;
+  return Number.isFinite(unitsPerPixel) && unitsPerPixel > 0
+    ? unitsPerPixel
+    : undefined;
+}
+
+/** The largest 1, 2 or 5 times a power of ten that is at most maxLength. */
+export function niceLength(maxLength: number): number {
+  let decade = 10 ** Math.floor(Math.log10(maxLength));
+  // Math.log10 can land just beside an exact power of ten.
+  if (decade > maxLength) decade /= 10;
+  if (decade * 10 <= maxLength) decade *= 10;
+  const step = [5, 2, 1].find((s) => s * decade <= maxLength) ?? 1;
+  // Strip floating point noise such as 0.30000000000000004.
+  return Number((step * decade).toPrecision(1));
+}
+
+/** A round bar length and its on-screen width for the current zoom. */
+export function scaleBarSize(
+  unitsPerPixel: number,
+  maxWidthPx = SCALE_BAR_MAX_WIDTH_PX,
+): { length: number; widthPx: number } {
+  const length = niceLength(unitsPerPixel * maxWidthPx);
+  return { length, widthPx: length / unitsPerPixel };
+}
