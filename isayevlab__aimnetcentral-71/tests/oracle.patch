+    """A trivially perturbed H2O2 starting from a non-stationary geometry."""
+    from ase import Atoms
+
+    return Atoms(
+        "H2O2",
+        positions=[
+            [0.000, 0.700, 0.350],
+            [0.000, -0.700, 0.350],
+            [0.000, 0.700, -0.350],
+            [0.000, -0.700, -0.350],
+        ],
+    )
+
+
